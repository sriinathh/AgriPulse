# Copy to backend/.env; never commit .env
# Local zero-setup default:
DATABASE_URL=sqlite:///./irrigation.db
# TimescaleDB in Docker (host port 5433 — see docker-compose.yml):
# DATABASE_URL=postgresql+psycopg2://irrigation:irrigation@localhost:5433/irrigation

APP_ENV=development
APP_VERSION=0.2.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Add your own key in backend/.env — never commit the real value
OPENWEATHER_API_KEY=
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5/weather
WEATHER_TIMEOUT_SECONDS=5
WEATHER_MOCK=false

# MQTT is optional. Application startup does not require a broker.
MQTT_ENABLED=false
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC=irrigation/sensors/#
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=smart-irrigation-backend
